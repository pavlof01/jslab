# ============================================================
# STAGE 1 — build JavaScriptCore (JSCOnly)
# ============================================================
FROM ubuntu:24.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive

# ---- build dependencies ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    python3 \
    ruby ruby-dev \
    perl \
    pkg-config \
    cmake \
    ninja-build \
    clang \
    lld \
    lldb \
    build-essential \
    bison \
    flex \
    gperf \
    libgtk-3-dev \
    libglib2.0-dev \
    libicu-dev \
    libxml2-dev \
    libxslt1-dev \
    libsqlite3-dev \
    libjpeg-dev \
    libpng-dev \
    libwebp-dev \
    libsoup-3.0-dev \
    libharfbuzz-dev \
    libwoff1 \
    libtasn1-6-dev \
    libwayland-dev \
    libxkbcommon-dev \
    libegl1-mesa-dev \
    libgles2-mesa-dev \
    libgbm-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root

# ---- clone WebKit ----
RUN git clone --depth=1 https://github.com/WebKit/WebKit.git webkit
WORKDIR /root/webkit

# ---- build JavaScriptCore only (Release) ----
RUN Tools/Scripts/build-webkit \
    --jsc-only \
    --release

# ============================================================
# STAGE 2 — runtime image (minimal)
# ============================================================
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libglib2.0-0 \
    libicu74 \
    libxml2 \
    libxslt1.1 \
    libsqlite3-0 \
    libjpeg-turbo8 \
    libpng16-16 \
    libwebp7 \
    libsoup-3.0-0 \
    libharfbuzz0b \
    libxkbcommon0 \
    libegl1 \
    libgles2 \
    libgbm1 \
    && rm -rf /var/lib/apt/lists/*

# ---- copy jsc binary ----
COPY --from=builder \
    /root/webkit/WebKitBuild/Release/bin/jsc \
    /usr/local/bin/jsc

RUN chmod +x /usr/local/bin/jsc

WORKDIR /workspace

ENTRYPOINT ["jsc"]
CMD ["-e", "print(1 + 1)"]
