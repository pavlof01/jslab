# === STAGE 1: build d8 ===
FROM ubuntu:24.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl python3 \
    ca-certificates \
    build-essential \
    ninja-build \
    pkg-config \
    subversion \
    libglib2.0-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://chromium.googlesource.com/chromium/tools/depot_tools.git /depot_tools
ENV PATH="/depot_tools:${PATH}"

WORKDIR /root
RUN fetch v8

WORKDIR /root/v8
RUN gclient sync

RUN rm -rf out.gn/x64.release && \
    tools/dev/v8gen.py x64.release -- \
      is_debug=false \
      v8_enable_i18n_support=false \
      is_component_build=false \
      use_custom_libcxx=false \
      use_sysroot=false \
      treat_warnings_as_errors=false \
      target_cpu=\"x64\"

RUN ninja -C out.gn/x64.release d8

# Create minimal runtime bundle
RUN set -eux; \
    mkdir -p /tmp/v8-runtime; \
    cp out.gn/x64.release/d8 /tmp/v8-runtime/; \
    cp out.gn/x64.release/snapshot_blob.bin /tmp/v8-runtime/; \
    if [ -f out.gn/x64.release/icudtl.dat ]; then cp out.gn/x64.release/icudtl.dat /tmp/v8-runtime/; fi; \
    if [ -f out.gn/x64.release/natives_blob.bin ]; then cp out.gn/x64.release/natives_blob.bin /tmp/v8-runtime/; fi; \
    ls -la /tmp/v8-runtime

# === STAGE 2: runtime (glibc-compatible) ===
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates bash libatomic1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/v8
COPY --from=builder /tmp/v8-runtime/ /opt/v8/

# Wrapper: always run d8 from /opt/v8 so snapshot_blob.bin is found
RUN set -eux; \
    printf '%s\n' \
      '#!/usr/bin/env bash' \
      'set -euo pipefail' \
      'cd /opt/v8' \
      'exec /opt/v8/d8 "$@"' \
      > /usr/local/bin/d8; \
    chmod +x /usr/local/bin/d8

WORKDIR /workspace
ENTRYPOINT ["d8"]
CMD ["--help"]
