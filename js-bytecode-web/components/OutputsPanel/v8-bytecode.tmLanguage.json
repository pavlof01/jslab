{
  "name": "v8bc",
  "displayName": "V8 Bytecode",
  "scopeName": "source.v8bc",
  "fileTypes": ["v8bc", "d8log", "v8bytecode", "bytecode"],
  "patterns": [
    { "include": "#header" },
    { "include": "#section-head" },
    { "include": "#meta-lines" },
    { "include": "#opcode-line" },
    { "include": "#constants-block" },
    { "include": "#handler-table" },
    { "include": "#source-position-table" }
  ],
  "repository": {
    "header": {
      "patterns": [
        {
          "name": "entity.name.section.header.v8bc",
          "match": "^(\\[generated bytecode for function:[^\\]]*\\])"
        },
        {
          "name": "entity.name.section.header.v8bc",
          "match": "^(<global>#[^:]+:.*)$"
        },
        {
          "name": "entity.name.section.header.v8bc",
          "match": "^[A-Za-z0-9_]+#[^:]+:.*$"
        }
      ]
    },

    "section-head": {
      "patterns": [
        {
          "name": "markup.heading.section.v8bc",
          "match": "^(Constant pool|Handler Table|Source Position Table) \\(size = \\d+\\)"
        },
        {
          "name": "markup.heading.section.v8bc",
          "match": "^(Identifiers|Constants|Predecessors|Successors):\\s*$"
        }
      ]
    },

    "meta-lines": {
      "patterns": [
        {
          "name": "comment.line.meta.v8bc",
          "match": "^Bytecode length:\\s*\\d+"
        },
        {
          "name": "comment.line.meta.v8bc",
          "match": "^Parameter count\\s*\\d+"
        },
        {
          "name": "comment.line.meta.v8bc",
          "match": "^Register count\\s*\\d+"
        },
        {
          "name": "comment.line.meta.v8bc",
          "match": "^Frame size\\s*\\d+"
        }
      ]
    },

    "opcode-line": {
      "patterns": [
        {
          "name": "meta.instruction.line.v8bc",
          "begin": "^\\s*(0x[0-9a-fA-F]{8,})\\s*@\\s*(\\d+)\\s*:\\s*((?:[0-9a-fA-F]{2}\\s+)*[0-9a-fA-F]{2})\\s+",
          "beginCaptures": {
            "1": { "name": "constant.numeric.hex.address.v8bc" },
            "2": { "name": "constant.numeric.dec.offset.v8bc" },
            "3": { "name": "string.unquoted.hexbytes.v8bc" }
          },
          "end": "$",
          "patterns": [{ "include": "#opcode" }, { "include": "#operands" }, { "include": "#inline-comments" }]
        }
      ]
    },

    "opcode": {
      "patterns": [
        {
          "name": "keyword.operator.opcode.v8bc",
          "match": "\\b(?:LdaZero|LdaUndefined|LdaNull|LdaTheHole|LdaTrue|LdaFalse|LdaSmi|LdaConstant|LdaGlobal|Mov|Star0|Star1|Star2|StaGlobal|CreateClosure|CreateObjectLiteral|CreateArrayLiteral|Call|CallProperty|CallUndefinedReceiver0|CallUndefinedReceiver1|CallUndefinedReceiver2|CallUndefinedReceiver3|CallRuntime|TailCallRuntime|Construct|Return|Jump|JumpIfTrue|JumpIfFalse|JumpIfToBooleanTrue|JumpIfToBooleanFalse|TestEqual|TestEqualStrict|TestLessThan|TestGreaterThan|TestLessThanOrEqual|TestGreaterThanOrEqual|GetNamedProperty|SetNamedProperty|GetKeyedProperty|SetKeyedProperty|DefineNamedOwnProperty|DefineKeyedOwnProperty|ForInEnumerate|ForInNext|TypeOf|ToBoolean|Add|AddSmi|Sub|Mul|Div|Mod|BitwiseAnd|BitwiseOr|BitwiseXor|ShiftLeft|ShiftRight|ShiftRightLogical|Inc|Dec|Negate|Not|LogicalNot|DeleteProperty|Throw|ReThrow|SuspendGenerator|ResumeGenerator|Nop)\\b"
        }
      ]
    },

    "operands": {
      "patterns": [
        {
          "name": "variable.language.register.v8bc",
          "match": "\\br\\d+\\b"
        },
        {
          "name": "variable.parameter.register.v8bc",
          "match": "\\ba\\d+\\b"
        },
        {
          "name": "support.variable.special.v8bc",
          "match": "<closure>|<context>|<this>|<arguments>"
        },
        {
          "name": "constant.other.pool-index.v8bc",
          "match": "\\[\\d+\\]"
        },
        {
          "name": "storage.modifier.flagset.v8bc",
          "match": "\\bgetPutInfo:[^,\\s]+|resolveType:[A-Za-z]+|valueProfile:\\d+"
        },
        {
          "name": "entity.name.function.runtime.v8bc",
          "match": "\\[(?:DeclareGlobals|\\w+)\\]"
        }
      ]
    },

    "inline-comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.v8bc",
          "match": "\\s+;.*$"
        }
      ]
    },

    "constants-block": {
      "begin": "^Constant pool \\(size = \\d+\\)\\s*$",
      "end": "^(?=Handler Table|Source Position Table|\\[generated bytecode|\\w+#|<global>#|$)",
      "name": "meta.constants.block.v8bc",
      "patterns": [
        {
          "name": "constant.numeric.hex.address.v8bc",
          "match": "^0x[0-9a-fA-F]{8,}:"
        },
        {
          "name": "entity.name.type.heapobj.v8bc",
          "match": "<[A-Za-z0-9_]+(?:\\[[0-9]+\\])?>"
        },
        {
          "name": "string.quoted.other.v8bc",
          "match": "<String\\[\\d+\\]:\\s*#[^>]+>"
        },
        {
          "name": "constant.numeric.dec.v8bc",
          "match": "\\b(?:length|index|offset):\\s*\\d+"
        },
        {
          "name": "punctuation.definition.list.v8bc",
          "match": "^\\s*-\\s+map:|^\\s*-\\s+length:"
        }
      ]
    },

    "handler-table": {
      "begin": "^Handler Table \\(size = \\d+\\)\\s*$",
      "end": "^(?=Source Position Table|\\[generated bytecode|\\w+#|<global>#|$)",
      "name": "meta.handler.table.v8bc"
    },

    "source-position-table": {
      "begin": "^Source Position Table \\(size = \\d+\\)\\s*$",
      "end": "^(?=\\[generated bytecode|\\w+#|<global>#|$)",
      "name": "meta.source.position.table.v8bc"
    }
  }
}
