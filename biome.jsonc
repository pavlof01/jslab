{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  // One Biome for the whole tree. Each service under apps/ and packages/ still
  // owns its package.json, lockfile and tsconfig — only formatting, linting and
  // import order are centralised here so they cannot drift per service.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    // Picks up the root .gitignore plus the nested one in apps/frontend/src.
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      // Repeated from .gitignore so `biome ci` behaves the same in a checkout
      // that has not run any build yet.
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/coverage",
      "!**/package-lock.json",
      "!**/*.min.js",
      // Vendored engine262 submodule — upstream code, not ours to reformat.
      "!apps/trace-service/engine262",
      // A ~10 MB copy of the ECMAScript spec the trace service parses at runtime.
      "!apps/trace-service/src/server/ecma-spec.html",
      "!apps/frontend/src/public",
      // Generated by `next dev`/`next build`.
      "!apps/frontend/src/next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    // 100 rather than the default 80: it matches how the tree was already
    // written (95% of lines fit in 90 columns) and keeps the adoption diff to
    // real reflows instead of wrapping every second line.
    "lineWidth": 100,
    "lineEnding": "lf",
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // Array.prototype.forEach is idiomatic here and reads fine.
        "noForEach": "off",
        // obj["key"] is often deliberate around index signatures.
        "useLiteralKeys": "off",
        // Several services embed engine source as String.raw templates. The tag
        // is deliberate there — it keeps backslashes literal when the embedded
        // program grows one — even while no escape happens to be present today.
        "noUselessStringRaw": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error",
        // ESLint owns the React hooks rules in the frontend (see below); running
        // both would double-report the same dependency arrays.
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "noNegationElse": "off",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useBlockStatements": "off",
        "useCollapsedElseIf": "error",
        "useConsistentArrayType": { "level": "error", "options": { "syntax": "shorthand" } },
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        // `import type` / `export type` matter beyond taste: trace-service builds
        // with verbatimModuleSyntax, where a value import of a type is an error.
        "useExportType": "error",
        "useImportType": "error",
        // node: protocol — the services run on Node 22 and import fs/os/path.
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useShorthandFunctionType": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "error",
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        // Services log through pino, the frontend through the browser console
        // only for genuine failures. console.log left in a diff is a mistake.
        "noConsole": { "level": "error", "options": { "allow": ["error", "warn"] } },
        // A warning, not an error: some `any` is unavoidable at the engine262
        // and Monaco boundaries. Visible, but not a merge blocker.
        "noExplicitAny": "warn",
        // Off, not on: every service here is Fastify, where `async` handlers
        // that only `return` a payload are the documented style. The rule
        // flags all of them and finds nothing else.
        "useAwait": "off"
      },
      "performance": {
        "noDelete": "error"
      },
      // Nursery rules change shape between releases; opting in would make a
      // Biome upgrade break CI on unrelated PRs.
      "nursery": {
        "preset": "none"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteProperties": "asNeeded"
    },
    "globals": []
  },
  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    },
    "parser": {
      "allowComments": false,
      "allowTrailingCommas": false
    }
  },
  "css": {
    "formatter": { "enabled": true },
    "linter": { "enabled": true }
  },
  "overrides": [
    {
      // JSON files that are JSONC by convention.
      "includes": [
        "**/tsconfig*.json",
        "**/jsconfig*.json",
        "**/biome.json",
        "**/biome.jsonc",
        "**/.vscode/*.json",
        "**/*.jsonc"
      ],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    },
    {
      // Domains switch on the framework-aware rules only where the framework is.
      "includes": ["apps/frontend/**"],
      "linter": {
        "domains": {
          "react": "recommended",
          "next": "recommended"
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.mts",
        "**/*.spec.ts",
        "**/test/**",
        "**/__tests__/**"
      ],
      "linter": {
        "domains": {
          "test": "recommended"
        },
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off"
          },
          "style": {
            // `screen.getByX(...)!` after an assertion is how these tests read.
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      // Standalone Node scripts and config files: stdout is their interface.
      "includes": ["scripts/**", "apps/frontend/src/scripts/**", "**/*.config.{ts,mts,js,mjs}"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      // Bytecode specimens, not application code. These files exist to make an
      // engine emit every opcode, so `arguments`, `==`, `throw "string"`,
      // unreachable statements and functions named `useX` are the point of
      // them. Formatting still applies; linting them would be nonsense.
      "includes": ["scripts/switch.js", "apps/frontend/src/scripts/full-bytecode.js"],
      "linter": { "enabled": false }
    },
    {
      // The `${1:fn}` sequences in here are Monaco snippet placeholders inside
      // ordinary strings, not template literals someone forgot to backtick.
      "includes": ["apps/frontend/src/lib/v8Intrinsics.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
