{
  "name": "v8bc",
  "displayName": "V8 Bytecode",
  "scopeName": "source.v8bc",
  "fileTypes": ["v8bc", "d8log", "v8bytecode", "bytecode"],
  "foldingStartMarker": "^(Constant pool|Handler Table|Source Position Table) \\(size = \\d+\\)\\s*$",
  "foldingStopMarker": "^(?=\\[generated bytecode|\\w+#|<global>#|$)",
  "patterns": [
    { "include": "#header" },
    { "include": "#section-head" },
    { "include": "#meta-lines" },
    { "include": "#opcode-line" },
    { "include": "#constants-block" },
    { "include": "#constants-loose" },
    { "include": "#handler-table" },
    { "include": "#source-position-table" },
    { "include": "#trailing-output" }
  ],
  "repository": {
    "header": {
      "patterns": [
        { "name": "entity.name.section.header.v8bc", "match": "^(\\[generated bytecode for function:[^\\]]*\\])" },
        { "name": "entity.name.section.header.v8bc", "match": "^(<global>#[^:]+:.*)$" },
        { "name": "entity.name.section.header.v8bc", "match": "^[A-Za-z0-9_]+#[^:]+:.*$" }
      ]
    },

    "section-head": {
      "patterns": [
        {
          "name": "markup.heading.section.v8bc",
          "match": "^(Constant pool|Handler Table|Source Position Table) \\(size = \\d+\\)"
        },
        { "name": "markup.heading.section.v8bc", "match": "^(Identifiers|Constants|Predecessors|Successors):\\s*$" }
      ]
    },

    "meta-lines": {
      "patterns": [
        { "name": "comment.line.meta.v8bc", "match": "^Bytecode length:\\s*\\d+" },
        { "name": "comment.line.meta.v8bc", "match": "^Parameter count\\s*\\d+" },
        { "name": "comment.line.meta.v8bc", "match": "^Register count\\s*\\d+" },
        { "name": "comment.line.meta.v8bc", "match": "^Frame size\\s*\\d+" }
      ]
    },

    "opcode-line": {
      "patterns": [
        {
          "name": "meta.instruction.line.v8bc",
          "begin": "^\\s*(0x[0-9A-Fa-f]+)\\s*@?\\s*(\\d+)\\s*:\\s*((?:[0-9A-Fa-f]{2}(?:\\s+|$))+)",
          "beginCaptures": {
            "1": { "name": "constant.numeric.hex.address.v8bc" },
            "2": { "name": "constant.numeric.dec.offset.v8bc" },
            "3": { "name": "string.unquoted.hexbytes.v8bc" }
          },
          "end": "$",
          "patterns": [
            { "include": "#opcode" },
            { "include": "#operands" },
            { "include": "#numbers" },
            { "include": "#switch-case-table" },
            { "include": "#target-annotation" },
            { "include": "#inline-comments" }
          ]
        }
      ]
    },

    "opcode": {
      "patterns": [
        {
          "name": "keyword.operator.opcode.v8bc",
          "match": "\\b(?:LdaZero|LdaUndefined|LdaNull|LdaTheHole|LdaTrue|LdaFalse|LdaSmi|LdaConstant|LdaGlobal|Ldar|Mov|Star\\d+|StaGlobal|CreateClosure|CreateObjectLiteral|CreateArrayLiteral|Construct|Call|CallProperty|CallProperty0|CallProperty1|CallProperty2|CallUndefinedReceiver0|CallUndefinedReceiver1|CallUndefinedReceiver2|CallUndefinedReceiver3|CallRuntime|TailCallRuntime|Return|Jump|JumpLoop|JumpIfTrue|JumpIfFalse|JumpIfToBooleanTrue|JumpIfToBooleanFalse|JumpIfJSReceiver|JumpIfUndefinedOrNull|TestEqual|TestEqualStrict|TestLessThan|TestGreaterThan|TestLessThanOrEqual|TestGreaterThanOrEqual|TestReferenceEqual|GetNamedProperty|SetNamedProperty|GetKeyedProperty|SetKeyedProperty|StaInArrayLiteral|DefineNamedOwnProperty|DefineKeyedOwnProperty|ForInEnumerate|ForInNext|TypeOf|ToBoolean|ToNumeric|Add|AddSmi|Sub|Mul|Div|Mod|BitwiseAnd|BitwiseOr|BitwiseXor|ShiftLeft|ShiftRight|ShiftRightLogical|Inc|Dec|Negate|Not|LogicalNot|DeleteProperty|Throw|ReThrow|SuspendGenerator|ResumeGenerator|SwitchOnSmiNoFeedback|SwitchOnGeneratorState|GetIterator|SetPendingMessage|InvokeIntrinsic|LdaCurrentContextSlot|LdaImmutableCurrentContextSlot|StaCurrentContextSlot|StaCurrentContextSlotNoCell|PushContext|CreateCatchContext|Nop)\\b"
        }
      ]
    },

    "operands": {
      "patterns": [
        { "name": "variable.language.register.range.v8bc", "match": "\\br\\d+-r\\d+\\b" },
        { "name": "variable.language.register.list.v8bc", "match": "\\br\\d+(?:,\\s*r\\d+)+\\b" },
        { "name": "variable.language.register.v8bc", "match": "\\br\\d+\\b" },
        { "name": "variable.parameter.register.v8bc", "match": "\\ba\\d+\\b" },
        { "name": "support.variable.special.v8bc", "match": "<(?:closure|context|this|arguments)>" },
        { "name": "constant.other.pool-index.v8bc", "match": "\\[[-+]?\\d+\\]" },
        { "name": "entity.name.function.runtime.v8bc", "match": "\\[(?:DeclareGlobals|[A-Za-z_][A-Za-z0-9_]*)\\]" },
        { "name": "support.constant.global.v8bc", "match": "\\b<global>\\b" },
        { "name": "punctuation.separator.v8bc", "match": "," }
      ]
    },

    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.v8bc", "match": "\\b0x[0-9A-Fa-f]+\\b" },
        { "name": "constant.numeric.dec.v8bc", "match": "(?<![A-Za-z_])[-+]?\\b\\d+\\b" },
        { "name": "constant.other.target.v8bc", "match": "@\\d+" },
        { "name": "constant.numeric.immediate.v8bc", "match": "#\\d+" }
      ]
    },

    "switch-case-table": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.definition.block.begin.v8bc" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.block.end.v8bc" } },
      "name": "meta.switch.table.v8bc",
      "patterns": [
        { "name": "constant.numeric.dec.v8bc", "match": "\\b\\d+\\b" },
        { "name": "constant.other.target.v8bc", "match": "@\\d+" },
        { "name": "punctuation.separator.key-value.v8bc", "match": ":" },
        { "name": "punctuation.separator.comma.v8bc", "match": "," },
        { "name": "punctuation.whitespace.v8bc", "match": "\\s+" }
      ]
    },

    "target-annotation": {
      "name": "comment.line.annotation.target.v8bc",
      "match": "\\s*\\([^)]*\\)\\s*$"
    },

    "inline-comments": {
      "patterns": [{ "name": "comment.line.semicolon.v8bc", "match": "\\s+;.*$" }]
    },

    "constants-block": {
      "begin": "^Constant pool \\(size = \\d+\\)\\s*$",
      "end": "^(?=Handler Table|Source Position Table|\\[generated bytecode|\\w+#|<global>#|$)",
      "name": "meta.constants.block.v8bc",
      "patterns": [
        { "name": "constant.numeric.hex.address.v8bc", "match": "^0x[0-9A-Fa-f]+:" },
        {
          "name": "entity.name.type.scopeinfo.v8bc",
          "match": "<ScopeInfo\\s+([A-Z_]+)>",
          "captures": {
            "1": { "name": "constant.language.scopekind.v8bc" }
          }
        },
        {
          "name": "entity.name.type.heapobj.v8bc",
          "match": "<[A-Za-z0-9_]+(?:\\[[\\d]+\\])?(?:\\s+[A-Z_]+(?:,[^>]+)?)?>"
        },
        { "name": "entity.name.type.heapobj.v8bc", "match": "<[A-Za-z0-9_]+\\s+[^>]+>" },
        { "name": "string.quoted.other.v8bc", "match": "<String\\[\\d+\\]:\\s*#[^>]+>" },
        { "name": "constant.numeric.dec.v8bc", "match": "\\b(?:length|index|offset):\\s*\\d+" },
        { "name": "punctuation.definition.list.v8bc", "match": "^\\s*-\\s+(?:map:|length:)" }
      ]
    },

    "constants-loose": {
      "patterns": [
        { "name": "constant.numeric.hex.address.v8bc", "match": "^0x[0-9A-Fa-f]+:" },
        { "name": "entity.name.type.heap-tag.v8bc", "match": "\\[[A-Za-z][A-Za-z0-9_() ]*\\]" },
        { "name": "entity.name.type.heapobj.v8bc", "match": "<[^>]+>" },
        { "name": "keyword.operator.meta.v8bc", "match": "^\\s*-\\s+(?:map|length):" },
        { "name": "constant.numeric.dec.v8bc", "match": "\\b\\d+\\b" }
      ]
    },

    "handler-table": {
      "begin": "^Handler Table \\(size = \\d+\\)\\s*$",
      "end": "^(?=Source Position Table|\\[generated bytecode|\\w+#|<global>#|$)",
      "name": "meta.handler.table.v8bc",
      "patterns": [
        { "name": "keyword.other.handler.header.v8bc", "match": "^\\s*\\(\\s*from\\s*to\\s*hdlr.*\\)$" },
        { "name": "constant.numeric.dec.v8bc", "match": "\\b\\d+\\b" },
        { "name": "punctuation.v8bc", "match": "[(),=-]" }
      ]
    },

    "source-position-table": {
      "begin": "^Source Position Table \\(size = \\d+\\)\\s*$",
      "end": "^(?=\\[generated bytecode|\\w+#|<global>#|$)",
      "name": "meta.source.position.table.v8bc"
    },

    "trailing-output": {
      "name": "meta.program.output.v8bc",
      "match": "^[A-Za-z].*$"
    }
  }
}
