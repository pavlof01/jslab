# syntax=docker/dockerfile:1.7

########################
# Builder (amd64 host toolchain)
########################
FROM --platform=linux/amd64 ubuntu:24.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates python3 \
    build-essential \
    ninja-build pkg-config \
    xz-utils file \
  && rm -rf /var/lib/apt/lists/*

# depot_tools
RUN git clone https://chromium.googlesource.com/chromium/tools/depot_tools.git /depot_tools
ENV PATH="/depot_tools:${PATH}"

WORKDIR /root
RUN fetch v8

WORKDIR /root/v8

# Cache gclient / git downloads
RUN --mount=type=cache,target=/root/.cache \
    --mount=type=cache,target=/root/.config \
    --mount=type=cache,target=/root/.gitcache \
    gclient sync

# If building arm64 target, install sysroot for cross-compiling.
RUN if [ "${TARGETARCH}" = "arm64" ]; then \
      python3 build/linux/sysroot_scripts/install-sysroot.py --arch=arm64; \
    fi

# GN gen + build + export artifacts
# We branch by TARGETARCH so one Dockerfile works for both platforms.
RUN set -eux; \
    if [ "${TARGETARCH}" = "amd64" ]; then \
      OUT=out/release_amd64; \
      CACHE_ID=v8-out-amd64; \
      GN_ARGS='is_debug=true is_component_build=false symbol_level=0 target_cpu="x64" v8_enable_i18n_support=false v8_use_external_startup_data=true'; \
    elif [ "${TARGETARCH}" = "arm64" ]; then \
      OUT=out/release_arm64; \
      CACHE_ID=v8-out-arm64; \
      GN_ARGS='is_debug=true is_component_build=false symbol_level=0 target_cpu="arm64" v8_enable_i18n_support=false v8_use_external_startup_data=true'; \
    else \
      echo "Unsupported TARGETARCH=${TARGETARCH}"; exit 1; \
    fi; \
    echo "OUT=$OUT CACHE_ID=$CACHE_ID"; \
    true

# GN gen (share out/ cache per arch)
RUN --mount=type=cache,id=v8-out-${TARGETARCH},target=/root/v8/out \
    set -eux; \
    if [ "${TARGETARCH}" = "amd64" ]; then OUT=out/release_amd64; GN_ARGS='is_debug=true is_component_build=false symbol_level=0 target_cpu="x64" v8_enable_i18n_support=false v8_use_external_startup_data=true'; fi; \
    if [ "${TARGETARCH}" = "arm64" ]; then OUT=out/release_arm64; GN_ARGS='is_debug=true is_component_build=false symbol_level=0 target_cpu="arm64" v8_enable_i18n_support=false v8_use_external_startup_data=true'; fi; \
    gn gen "${OUT}" --args="${GN_ARGS}"

# Build d8 (use small parallelism to avoid OOM on builders)
RUN --mount=type=cache,id=v8-out-${TARGETARCH},target=/root/v8/out \
    set -eux; \
    if [ "${TARGETARCH}" = "amd64" ]; then OUT=out/release_amd64; fi; \
    if [ "${TARGETARCH}" = "arm64" ]; then OUT=out/release_arm64; fi; \
    ninja -C "${OUT}" -j2 d8

# Export artifacts to a real layer
RUN --mount=type=cache,id=v8-out-${TARGETARCH},target=/root/v8/out \
    set -eux; \
    if [ "${TARGETARCH}" = "amd64" ]; then OUT=out/release_amd64; fi; \
    if [ "${TARGETARCH}" = "arm64" ]; then OUT=out/release_arm64; fi; \
    mkdir -p /artifacts; \
    cp -v "${OUT}/d8" /artifacts/; \
    cp -v "${OUT}/snapshot_blob.bin" /artifacts/

########################
# Runtime (final image)
########################
FROM --platform=$TARGETPLATFORM debian:bookworm-slim AS runtime

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates bash libatomic1 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/v8

COPY --from=builder /artifacts/d8 /opt/v8/d8
COPY --from=builder /artifacts/snapshot_blob.bin /opt/v8/snapshot_blob.bin

ENTRYPOINT ["/opt/v8/d8"]